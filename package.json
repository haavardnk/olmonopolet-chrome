{
  "name": "olmonopolet-chrome",
  "version": "0.4.1",
  "description": "Vurderinger og ølfakta fra Ølmonopolet på Vinmonopolet.no",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "tsc --noEmit && wxt build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "zip": "tsc --noEmit && wxt zip",
    "postinstall": "wxt prepare"
  },
  "license": "LGPL-3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  }
}
